{
  "name": "Instrument",
  "background": "#FFFFFF",
  "seriesOrder": ["#111111", "#6B6B6B", "#C8102E"],
  "note": "Signal red marks the value under discussion, never a whole series.",
  "font": { "labels": "DM Mono", "size": 11, "tabularFigures": true },
  "axis": {
    "lineColor": "#111111", "lineWidth": 1.5,
    "labelColor": "#6B6B6B", "labelTransform": "uppercase", "labelTracking": "0.12em",
    "gridColor": "#D8D8D8", "gridWidth": 1, "yGridOnly": true
  },
  "legend": { "show": false, "note": "Label series directly where possible." },
  "bar": { "cornerRadius": 0, "gap": 0.25 },
  "line": { "width": 2, "curve": "linear", "markers": false },
  "prohibited": ["gradient", "shadow", "borderRadius", "3d", "pie", "donut"],
  "unitsRequired": true
}
